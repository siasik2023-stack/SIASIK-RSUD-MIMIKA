#!/bin/sh
# ============================================================
# SIASIK — pre-commit hook
# Menjalankan otomatis sebelum commit:
#   1) node scripts/validate.js        (cek statis: sintaks, handler, id unik, dll.)
#   2) node scripts/test-form-simas.js (tes alur simpan Aset Masuk/Keluar, DOM mock)
# Commit DIBLOKIR jika salah satu gagal (regresi langsung ketahuan).
#
# Aktifkan (sekali saja per clone):  node scripts/install-git-hooks.js
# Uji manual:                        bash scripts/git-hooks/pre-commit
# Lewati paksa (tidak disarankan):   git commit --no-verify
#
# Catatan: hook ini dijalankan git dengan direktori kerja = akar repo,
# jadi path relatif `scripts/...` selalu benar.
# ============================================================
set -u

if ! command -v node >/dev/null 2>&1; then
  echo "⚠️  node tidak ditemukan di PATH — validasi pre-commit dilewati (commit tetap diproses)."
  echo "    Pasang Node.js (https://nodejs.org) agar validasi aktif."
  if [ "${SIASIK_HOOK_STRICT:-0}" = "1" ]; then
    echo "❌ SIASIK_HOOK_STRICT=1 — validasi wajib, commit dibatalkan."
    exit 1
  fi
  exit 0
fi

for SKRIP in validate.js test-form-simas.js; do
  echo "▶ SIASIK: node scripts/$SKRIP"
  if ! node "scripts/$SKRIP"; then
    echo ""
    echo "❌ GAGAL di scripts/$SKRIP — perbaiki masalah di atas sebelum commit."
    echo "   Untuk memaksa commit (tidak disarankan): git commit --no-verify"
    exit 1
  fi
done

echo "✅ Validasi pre-commit lulus (validate.js + test-form-simas.js)."
exit 0
