#!/bin/sh
# ============================================================
# SIASIK — pre-commit hook
# Menjalankan `node scripts/validate.js` otomatis sebelum commit.
# Commit DIBLOKIR jika validasi gagal (regresi langsung ketahuan).
#
# Aktifkan (sekali saja per clone):  node scripts/install-git-hooks.js
# Uji manual:                        bash scripts/git-hooks/pre-commit
# Lewati paksa (tidak disarankan):   git commit --no-verify
#
# Catatan: hook ini dijalankan git dengan direktori kerja = akar repo,
# jadi path relatif `scripts/validate.js` selalu benar.
# ============================================================
set -u

echo "▶ Validasi SIASIK (node scripts/validate.js)..."

if ! command -v node >/dev/null 2>&1; then
  echo "⚠️  node tidak ditemukan di PATH — validasi pre-commit dilewati (commit tetap diproses)."
  echo "    Pasang Node.js (https://nodejs.org) agar validasi aktif."
  if [ "${SIASIK_HOOK_STRICT:-0}" = "1" ]; then
    echo "❌ SIASIK_HOOK_STRICT=1 — validasi wajib, commit dibatalkan."
    exit 1
  fi
  exit 0
fi

if ! node scripts/validate.js; then
  echo ""
  echo "❌ VALIDASI GAGAL — perbaiki masalah di atas sebelum commit."
  echo "   Untuk memaksa commit (tidak disarankan): git commit --no-verify"
  exit 1
fi

echo "✅ Validasi pre-commit lulus."
exit 0
